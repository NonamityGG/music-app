<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system splash is the intro's background with its point of
         light, so opening the app flows straight into the intro -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rez_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_point</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="android:windowSplashScreenBackground">@color/rez_ink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_point</item>
        <item name="android:windowSplashScreenAnimationDuration">600</item>
        <item name="android:windowBackground">@color/rez_ink</item>
    </style>
</resources>
