<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows-side helper of Резонанс for PC: wallpaper behind the desktop icons,
       the top bar as an app bar, what's playing (system media controls), and
       whether a full-screen app is in front. Talks JSON lines over stdin/stdout. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RezonansHost</AssemblyName>
    <RootNamespace>Rezonans</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.22621.2428" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- JavaScriptSerializer for the JSON lines -->
    <Reference Include="System.Web.Extensions" />
    <!-- app icons for the Start menu, and the font switch -->
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
